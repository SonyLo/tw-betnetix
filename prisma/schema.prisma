generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  // id    Int     @id @default(autoincrement())
  id    Int     @unique // fonbet id
  name  String
  Group Group[]
}

model Group {
  // id        Int    @id @default(autoincrement())
  id        Int     @unique
  country   Country @relation(fields: [idCountry], references: [id])
  idCountry Int
  name      String
  Event     Event[]
}

model Event {
  // id        Int    @id @default(autoincrement())
  idFonbet Int    @unique
  group    Group  @relation(fields: [idGroup], references: [id])
  idGroup  Int
  name     String
}
